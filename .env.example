# Google Custom Search JSON API — copy this file to .env and replace with real values.
# https://developers.google.com/custom-search/v1/overview
# https://programmablesearchengine.google.com/
#
# Use an API key from Cloud Console → APIs & Services → Credentials (same project as the enabled API).
# API Explorer may use a different browser/session key — copy a key from Credentials for local scripts.
# For scripts: key “Application restrictions” should be None or IP addresses, not HTTP referrers only.

GOOGLE_API_KEY=AIzaSyDummyKeyReplaceWithYourGoogleCloudApiKey
GOOGLE_CSE_ID=012345678901234567890:abcdefghijk
